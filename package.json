{
  "name": "nestjs-amo",
  "version": "0.1.0",
  "description": "Wrapper over the @shevernitskiy/amo library for interacting with the amoCRM API from a NestJS application.",
  "scripts": {
    "start:dev": "tsc -w",
    "build": "tsc -p tsconfig.lib.json",
    "prepare": "npm run build",
    "format": "prettier --write \"lib/**/*.ts\"",
    "lint": "eslint  \"lib/**/*.ts\" --fix",
    "changelog": "npx conventional-changelog-cli conventional-changelog -p angular -i ./CHANGELOG.md -s"
  },
  "keywords": [
    "nestjs",
    "amocrm",
    "kommo",
    "api",
    "oauth2.0"
  ],
  "author": "Yaroslav Tolstoy <t.me/yatolstoy>",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/yatolstoy/nestjs-amo.git"
  },
  "bugs": {
    "url": "https://github.com/yatolstoy/nestjs-amo/issues"
  },
  "homepage": "https://github.com/yatolstoy/nestjs-amo#readme",
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@shevernitskiy/amo": "^0.1.0 || ^0.2.0"
  },
  "devDependencies": {
    "@shevernitskiy/amo": "^0.2.15",
    "@nestjs/common": "11.1.16",
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
